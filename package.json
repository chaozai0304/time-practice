{
  "name": "time-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs:screenshots": "npm run build && node scripts/capture-docs.mjs",
    "docs:verify": "node scripts/verify-docs.mjs",
    "sync": "npm run build && cap sync",
    "android:apk": "bash scripts/build-android.sh",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "ios:archive": "bash scripts/build-ios.sh",
    "icons:generate": "node scripts/generate-icons.mjs",
    "ios:check": "npm run sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -destination 'generic/platform=iOS' -derivedDataPath build/ios CODE_SIGNING_ALLOWED=NO build",
    "motion:studio": "remotion studio src/motion/entry.tsx --port=3001 --no-open",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.8.2",
    "@remotion/player": "^4.0.540",
    "@remotion/three": "^4.0.540",
    "lucide-react": "^1.68.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@remotion/cli": "^4.0.540",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
